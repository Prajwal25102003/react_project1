PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=employee_management
# Max pooled DB connections for this API process (default 10).
DB_POOL_MAX=10
# Shown in pg_stat_activity.application_name (helps spot who holds slots).
DB_APP_NAME=ems-api
JWT_SECRET=change-this-to-a-long-random-secret
# Prefer shorter session TTL in production (e.g. 12h). Logout is client-side only.
JWT_EXPIRES_IN=12h
# Short-lived HMAC tokens for /uploads/?exp=&sig= (seconds). Default 7200 (2h).
UPLOAD_TOKEN_TTL_SEC=7200
# JWT_SECRET is required — the API will not start without it.

# Used by npm run seed:users (min 12 characters). Required in production.
SEED_PASSWORD=replace-with-a-long-local-seed-password

# Comma-separated browser origins allowed to call the API (CORS).
# Defaults to localhost Vite/API if unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limits (requests per 15-minute window per IP)
RATE_LIMIT_SIGNIN_MAX=20
RATE_LIMIT_API_MAX=600
